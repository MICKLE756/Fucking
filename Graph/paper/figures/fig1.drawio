          <mxGeometry x="14" y="296" width="28" height="36" as="geometry" />
        </mxCell>

        <!-- Card B : our prediction -->
        <mxCell id="cardB" value="&lt;b&gt;Our evidence-based prediction&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#333333&quot;&gt;&amp;#10003;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Rachel is sad because &lt;u&gt;her flight got cancelled (utterance 1)&lt;/u&gt;: the necessity probe shows that masking utterance 3 leaves the prediction unchanged, and the bounded positional prior lets semantics override proximity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#8A8A8A;strokeWidth=1.2;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontFamily=Helvetica;fontSize=9.5;arcSize=8;" vertex="1" parent="1">
