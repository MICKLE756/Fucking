        <mxCell id="u1" value="&lt;b&gt;1-Monica:&lt;/b&gt; Your flight got cancelled&amp;nbsp;&amp;mdash; you will miss the wedding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;strokeWidth=1.6;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;fontSize=10;arcSize=14;" vertex="1" parent="1">
