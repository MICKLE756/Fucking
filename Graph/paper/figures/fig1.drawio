        <!-- Card A : baseline prediction -->
        <mxCell id="cardA" value="&lt;b&gt;Baseline prediction&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#616161&quot;&gt;&amp;#10007;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Rachel is sad because of &lt;u&gt;utterance 3 (the nearest one)&lt;/u&gt; or the &lt;u&gt;salient dinner topic in utterance 2&lt;/u&gt;&amp;nbsp;&amp;mdash; positional bias and spurious correlation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8A8A8A;strokeWidth=1.2;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontFamily=Helvetica;fontSize=9.5;arcSize=8;" vertex="1" parent="1">
